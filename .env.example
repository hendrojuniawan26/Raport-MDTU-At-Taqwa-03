# GEMINI_API_KEY: Required for Gemini AI API calls if server-side AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Client-side public keys)
# Dapatkan nilai ini dari Project Settings > API di Dashboard Supabase Anda
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
